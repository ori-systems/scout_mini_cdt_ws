<?xml version="1.0"?>
<!-- Composition belongs to cdt_ws; scout_ros2 remains an independent base model. -->
<robot name="scout_mini_cdt" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="scout_model" default="scout_mini/scout_mini_omni.xacro"/>
  <xacro:arg name="payload" default="true"/>
  <xacro:arg name="lidar_frame" default="velodyne"/>
  <xacro:arg name="nominal_camera_frames" default="false"/>
  <xacro:include filename="$(find scout_description)/urdf/$(arg scout_model)"/>
  <xacro:include filename="payload.xacro"/>
  <xacro:if value="$(arg payload)">
    <xacro:cdt_payload parent="base_link" lidar_frame="$(arg lidar_frame)"
                       imu_frame="cdt_d455_imu_optical_frame"
                       nominal_camera_frames="$(arg nominal_camera_frames)"/>
  </xacro:if>
</robot>
